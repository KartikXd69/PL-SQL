/* 
Program 6:  (P4.SQL)
Write a PL/SQL block which accepts measurement in feet and displays it in cm, inch and meter.

Formulas:
- Inches: feet * 12
- Centimeters: feet * 30.48
- Meters: feet * 0.3048
*/


SET SERVEROUTPUT ON
SET FEEDBACK OFF
SET VERIFY OFF

DECLARE
    V_FEET      	NUMBER(10,2);
    V_CM        	NUMBER(10,2);
    V_INCH      	NUMBER(10,2);
    V_METER   	  NUMBER(10,2);

BEGIN
    V_FEET := &ENTER_FEET;

    V_CM := V_FEET * 30.48;
    V_INCH := V_FEET * 12;
    V_METER := V_FEET * 0.3048;

    DBMS_OUTPUT.PUT_LINE('===========================================');
    DBMS_OUTPUT.PUT_LINE('	FEET CONVERSION DETAILS		');
    DBMS_OUTPUT.PUT_LINE('===========================================');

    DBMS_OUTPUT.PUT_LINE('Measurement in Feet        : ' || V_FEET || ' ft');
    DBMS_OUTPUT.PUT_LINE('Measurement in Centimeter  : ' || V_CM || ' cm');
    DBMS_OUTPUT.PUT_LINE('Measurement in Inch        : ' || V_INCH || ' inch');
    DBMS_OUTPUT.PUT_LINE('Measurement in Meter       : ' || V_METER || ' m');

    DBMS_OUTPUT.PUT_LINE('===========================================');

EXCEPTION
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Error : ' || SQLERRM);
END;
/
